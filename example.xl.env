# Stable Diffusion XL (SDXL) training defaults
BASE_MODEL="stabilityai/stable-diffusion-xl-base-1.0"
EXPERIMENT_CONFIG="configs/experiment.sdxl.yaml"
DATASET_DIR="${PWD}/dataset/knightro"
OUTPUT_DIR="${PWD}/artifacts/finetune/knightro_xl"
LOG_DIR="${PWD}/artifacts/finetune/knightro_xl/logs"
MODELS_DIR="${PWD}/models"
MERGE_SD_MODEL="${PWD}/models/sd_xl_base_1.0.safetensors"
MERGED_OUTPUT="${PWD}/artifacts/finetune/knightro_xl/merged.safetensors"
TRAIN_SCRIPT="sdxl_train_network.py"
MERGE_SCRIPT="networks/sdxl_merge_lora.py"
TRAIN_STEPS=1600
LEARNING_RATE=5e-5
BATCH_SIZE=1
MIXED_PRECISION=bf16
RESOLUTION=1024,1024
BUCKET_STEPS=128
MIN_BUCKET=512
MAX_BUCKET=1536
SAVE_EVERY=200
CAPTION_EXTENSION=.txt
NETWORK_MODULE=networks.lora
LR_SCHEDULER=cosine
MERGE_PRECISION=bf16
MERGE_SD_MODEL_URL="https://huggingface.co/stabilityai/stable-diffusion-xl-base-1.0/resolve/main/sd_xl_base_1.0.safetensors?download=true"
