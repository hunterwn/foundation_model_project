# Default environment variables for training Knightro LoRA
BASE_MODEL="runwayml/stable-diffusion-v1-5"
DATASET_DIR="${PWD}/dataset/knightro"
OUTPUT_DIR="${PWD}/artifacts/finetune/knightro"
LOG_DIR="${PWD}/artifacts/finetune/knightro/logs"
MODELS_DIR="${PWD}/models"
# MODEL_VARIANT auto-detects between sd15/sdxl; uncomment to force one.
# MODEL_VARIANT="sd15"
# TRAIN_METHOD can be "lora" (LoRA fine-tune + merge) or "full" (train_db.py)
TRAIN_METHOD="lora"
MERGE_SD_MODEL="${PWD}/models/sd-v1-5-pruned.safetensors"
MERGED_OUTPUT="${PWD}/artifacts/finetune/knightro/merged.safetensors"
TRAIN_STEPS=2000
LEARNING_RATE=1e-4
BATCH_SIZE=1
MIXED_PRECISION=fp16
RESOLUTION=512,512
SAVE_EVERY=200
BUCKET_STEPS=64
MIN_BUCKET=256
MAX_BUCKET=1024
CAPTION_EXTENSION=.txt
NETWORK_MODULE=networks.lora
LR_SCHEDULER=cosine
MERGE_PRECISION=fp16
MERGE_SD_MODEL_URL="https://huggingface.co/stable-diffusion-v1-5/stable-diffusion-v1-5/resolve/main/v1-5-pruned.safetensors?download=true"
# OPTIMIZER_ARGS lets you specify optimizer switches (e.g., "--optimizer_type=Adafactor --optimizer_args relative_step=False scale_parameter=False warmup_init=False")
# OPTIMIZER_ARGS=""
# EXTRA_TRAIN_ARGS lets you forward additional kohya flags (e.g., "--gradient_checkpointing --cache_latents")
# EXTRA_TRAIN_ARGS=""
# EXTRA_MERGE_ARGS lets you pass custom arguments to the merge script
# EXTRA_MERGE_ARGS=""
