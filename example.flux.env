# Flux.1-dev LoRA fine-tuning template (bash-j/kohya_ss fork)
# Copy this file to `.env` when you want to reproduce the Reddit workflow.

# Point to bash-j's fork (clone with submodules): git clone --recurse-submodules https://github.com/bash-j/kohya_ss.git external/kohya_flux
SD_SCRIPTS_DIR="${PWD}/external/kohya_flux/sd-scripts"

BASE_MODEL="black-forest-labs/FLUX.1-dev"
MODEL_VARIANT="sdxl"
TRAIN_METHOD="lora"

DATASET_DIR="${PWD}/dataset/knightro"
OUTPUT_DIR="${PWD}/artifacts/finetune/knightro_flux"
LOG_DIR="${PWD}/artifacts/finetune/knightro_flux/logs"
MODELS_DIR="${PWD}/models"

MERGE_SD_MODEL="${PWD}/models/flux1-dev.safetensors"
MERGED_OUTPUT="${PWD}/artifacts/finetune/knightro_flux/merged.safetensors"
MERGE_SD_MODEL_URL="https://huggingface.co/black-forest-labs/FLUX.1-dev/resolve/main/flux1-dev.safetensors?download=true"
MERGE_PRECISION=bf16

TRAIN_STEPS=42400
LEARNING_RATE=1.8e-6
BATCH_SIZE=1
MIXED_PRECISION=bf16
RESOLUTION=1024,1024
SAVE_EVERY=200
BUCKET_STEPS=64
MIN_BUCKET=256
MAX_BUCKET=2096
CAPTION_EXTENSION=.txt
NETWORK_MODULE=networks.lora
LR_SCHEDULER=constant_with_warmup

OPTIMIZER_ARGS="--optimizer_type=Adafactor --optimizer_args relative_step=False scale_parameter=False warmup_init=False"

EXTRA_TRAIN_ARGS="\
  --cache_latents \
  --cache_latents_to_disk \
  --clip_skip=1 \
  --dataset_repeats=10 \
  --fp8_base \
  --full_bf16 \
  --gradient_checkpointing \
  --huber_c=0.1 \
  --huber_schedule=snr \
  --loss_type=l2 \
  --lr_warmup_steps=4240 \
  --multires_noise_discount=0.3 \
  --sample_every_n_epochs=1 \
  --save_every_n_epochs=1 \
  --sample_sampler=euler_a \
  --save_state \
  --save_state_on_train_end \
  --sdpa \
  --seed=42 \
  --vae_batch_size=4 \
"

# Add merge-specific flags here if needed
EXTRA_MERGE_ARGS=""
